					<xs:enumeration value="Dead"/>              <!-- Dead -->
					<xs:enumeration value="LostToFollowUp"/>    <!-- Lost to follow-up -->
					<xs:enumeration value="TransferredOut"/>    <!-- Transferred Out -->
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
