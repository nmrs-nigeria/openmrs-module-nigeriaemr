				<!-- (After 3 consecutive months of good adherence to ART is achieved) -->

			<xs:element name="RepeatVLSampleCollectedDate" type="xs:date" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
