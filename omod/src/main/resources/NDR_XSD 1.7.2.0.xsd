					</xs:documentation>
				</xs:annotation>
			</xs:element>

			<xs:element name="RepeatViralLoadResult" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
					Repeat Viral Load Result in copies/ml
					</xs:documentation>
				</xs:annotation>
			</xs:element>

			<xs:element name="RepeatVLResultReceivedDate" type="xs:date" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
					Date Repeat Viral Load Result was Received (DD/MM/YYYY)
					</xs:documentation>
				</xs:annotation>
			</xs:element>

				<!-- Outcome -->
			<xs:element name="RepeatVLOutcomeCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
					Outcome of the Repeat Viral Load result
					</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="CodeType">
					<xs:enumeration value="Undetectable"/>            <!-- Undetectable: ≤50 copies/ml -->
					<xs:enumeration value="SuppressedButDetectable"/> <!-- Suppressed but detectable: >50 - ≤1000 copies/ml -->
					<xs:enumeration value="Unsuppressed"/>            <!-- Unsuppressed: >1000 copies/ml -->
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

				<!-- Plan -->
			<xs:element name="VLPlanOutcomeCode" minOccurs="0" maxOccurs="1">
