			<xs:element name="CompletedBy" type="xs:string" minOccurs="0" maxOccurs="1"/>
			<xs:element name="DateCompleted" type="xs:string" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
