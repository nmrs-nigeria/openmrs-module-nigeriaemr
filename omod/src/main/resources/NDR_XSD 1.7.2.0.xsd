<?xml version="1.0" encoding="utf-8" ?>
<!-- PURPOSE: NDR Schema is the basis for how information is exchanged from
	Electronic Medical Records (EMRs) to the National Data Repository (NDR) OVERVIEW:
	The NDR Schema is designed to be patient centric and support multiple conditions
	for a Patient. Originally developed by InductiveHealth Informatics, University Maryland Baltimore
	Updated and maintained by PHIS3
	Point of Contact: Gibril Gomez
	(hisupport@phis3project.org.ng) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">
	<xs:element name="Container">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="MessageHeader" type="MessageHeaderType" minOccurs="1" maxOccurs="1"/>
				<xs:choice>
					<xs:element name="IndividualReport" type="IndividualReportType" minOccurs="1" maxOccurs="1"/>
				</xs:choice>
				<xs:element name="Validation" type="xs:string" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="MessageHeaderType">
		<xs:sequence>
			<xs:element name="MessageStatusCode" minOccurs="1" maxOccurs="1">
				<xs:simpleType>
					<xs:annotation>
						<xs:documentation xml:lang="en">
                            The Message Status
                        </xs:documentation>
					</xs:annotation>
					<xs:restriction base="CodeType">
						<xs:enumeration value="INITIAL"/>
						<xs:enumeration value="UPDATED"/>
						<xs:enumeration value="REDACTED"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="MessageCreationDateTime" type="xs:dateTime" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Message Creation Date
                        and Time
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MessageSchemaVersion" minOccurs="1" maxOccurs="1" type="xs:string">
            </xs:element>
			<xs:element name="MessageUniqueID" type="StringType" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        The unique identifier
                        for this message. Used to communicate errors and status with
                        Sending Organization.
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MessageSendingOrganization" type="FacilityType" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        The Organization that
                        is sending the message and that is responsible for the facility.
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="FacilityType">
		<xs:sequence>
			<xs:element name="FacilityName" type="StringType" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        The Facility Name
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FacilityID" type="StringType" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        The Facility ID that is
                        used to uniquely identify the facility.
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FacilityTypeCode" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        The type of facility.
                    </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="IP"/>
						<xs:enumeration value="FAC"/>
						<xs:enumeration value="LGA"/>
						<xs:enumeration value="SGA"/>
						<xs:enumeration value="FGA"/>
						<xs:enumeration value="OTH"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IndividualReportType">
		<xs:sequence>
			<xs:element name="PatientDemographics" type="PatientDemographicsType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="Condition" type="ConditionType" minOccurs="1" maxOccurs="unbounded"/>
			<xs:element name="HIVTestingReport" type="HIVTestingReportType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="PMTCT" type="PMTCTType" maxOccurs="unbounded" minOccurs="0"/>
			<xs:element name="TB" type="TBType" maxOccurs="unbounded" minOccurs="0"/>
			<xs:element name="Mortality" type="MortalityType" maxOccurs="unbounded" minOccurs="0"/>
			<xs:element name="Recency" type="RecencyType" maxOccurs="unbounded" minOccurs="0"/>
			<xs:element name="ViralHepatitis" type="ViralHepatitisType" maxOccurs="unbounded" minOccurs="0"/>	
			<xs:element name="STIEntry" type="STIEntryType" minOccurs="0" maxOccurs="1"/>		
			<xs:element name="PrEP_PEP" type="PrEPType" minOccurs="0" maxOccurs="1"/>

		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PMTCTType">
		<xs:sequence>
			<xs:element name="PMTCTRegister" type="PMTCTRegisterType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="MotherInfantPairVisit" type="MotherInfantPairVisitType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="DeliveryChildrenDetails" type="DeliveryChildrenDetailsType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="InfantCohortRegistration" type="InfantCohortRegistrationType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InfantHBVProphylaxisType">
		<xs:sequence>
			<xs:element name="BirthDoseWithin24Hrs" type="xs:boolean" minOccurs="0" maxOccurs="1"/>
			<xs:element name="BirthDoseAfter24Hrs" type="xs:boolean" minOccurs="0" maxOccurs="1"/>
			<xs:element name="SecondDoseGiven" type="xs:boolean" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ThirdDoseGiven" type="xs:boolean" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="InfantARVProphylaxisType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="NVP"/>
			<xs:enumeration value="ZDV"/>
			<xs:enumeration value="NVP_and_ZDV"/>
			<xs:enumeration value="None"/>
			<xs:enumeration value="Other"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="InfantARVProphylaxisTimingType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="InFacilityWithin72Hrs"/>
			<xs:enumeration value="InFacilityAfter72Hrs"/>
			<xs:enumeration value="DeliveredOutsideFacilityWithin72Hrs"/>
			<xs:enumeration value="DeliveredFacilityAfter72Hrs"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CTXAgeCategoryType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="LT2Months"/>
			<xs:enumeration value="GTe2Months"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="PCRTestType">
		<xs:sequence>
			<xs:element name="AgeAtTest" type="PCRAgeAtTestType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="DateSampleCollected" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Result" type="PCRRapidTestResultType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="DateResultReceived" type="xs:date" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InfantRapidAntibodyTestType">
		<xs:sequence>
			<xs:element name="AgeAtTest_Months" type="xs:integer" minOccurs="0" maxOccurs="1"/>
			<xs:element name="DateOfTest" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Result" type="PCRRapidTestResultType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InfantARTEnrollmentType">
		<xs:sequence>
			<xs:element name="DateLinkedToARTClinic" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ARTEnrollmentNumber" type="xs:string" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InfantCohortRegistrationType">
		<xs:sequence>
			<xs:element name="DateOfBirth" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="DateOfFirstVisit" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="AgeAtFirstVisit" type="xs:int" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ChildHospitalRegNo" type="xs:string" minOccurs="0" maxOccurs="1"/>
			<xs:element name="InfantSex" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="M"/>
						<xs:enumeration value="F"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<!-- Coded per form legend -->
			<xs:element name="ChildEntryPoint" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="ANC"/>
						<xs:enumeration value="LD"/>
						<xs:enumeration value="Postnatal"/>
						<xs:enumeration value="Immunization"/>
						<xs:enumeration value="OPD"/>
						<xs:enumeration value="Inpatient"/>
						<xs:enumeration value="Nutrition"/>
						<xs:enumeration value="FamilyPlanning"/>
						<xs:enumeration value="TransferIn"/>
						<xs:enumeration value="Other"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="MotherHospitalNumber" type="xs:string" minOccurs="0" maxOccurs="1"/>
			<xs:element name="MotherANCNumber" type="xs:string" minOccurs="0" maxOccurs="1"/>
			<xs:element name="MotherStatus" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="HIV+"/>
						<xs:enumeration value="Syphilis+"/>
						<xs:enumeration value="HepatitisB+"/>
						<xs:enumeration value="HIVSyphilis+"/>
						<xs:enumeration value="HIVHBV+"/>
						<xs:enumeration value="SyphilisHBV+"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="MotherARTInitiationTiming" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="PriorOnPregnancy"/>
						<xs:enumeration value="InitiatedLessThan36Weeks"/>
						<xs:enumeration value="InitiatedGreaterThan36Weeks"/>
						<xs:enumeration value="InitiatedAtLabourAndDelivery"/>
						<xs:enumeration value="InitiatedAfterDelivery"/>
						<xs:enumeration value="None"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="MotherHIVARTRegimen" type="MotherCurrentARTRegimenType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="MotherSyphilisTreatmentStartDate" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="MotherHepatitisBTreatmentStartDate" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="InfantHBVProphylaxis" type="InfantHBVProphylaxisType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="InfantARVProphylaxisType" type="InfantARVProphylaxisType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="InfantARVProphylaxisTiming" type="InfantARVProphylaxisTimingType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="CTXAgeCategory" type="CTXAgeCategoryType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="FirstPCR" type="PCRTestType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="SecondPCR" type="ConfirmatoryPCRType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ThirdPCR" type="ConfirmatoryPCRType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ConfirmatoryPCR" type="ConfirmatoryPCRType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="RapidAntibodyTest" type="InfantRapidAntibodyTestType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="OutcomeAt18Months" type="InfantOutcomeStatusType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ARTEnrollment" type="InfantARTEnrollmentType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="PeriodOfHIVDiagnosisType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="PreviouslyInCareOrART"/>
			<xs:enumeration value="ANC"/>
			<xs:enumeration value="Labour"/>
			<xs:enumeration value="LessThan72HrsPostpartum"/>
			<xs:enumeration value="BreastfeedingPeriod"/>
			<xs:enumeration value="HIVNegative"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="PairCardSyphilisType">
		<xs:sequence>
			<xs:element name="TestResult" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Pos"/>
						<xs:enumeration value="Neg"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="TreatmentGiven" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Yes"/>
						<xs:enumeration value="No"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DrugName" type="xs:string" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PairCardHBVType">
		<xs:sequence>
			<xs:element name="TestResult" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Pos"/>
						<xs:enumeration value="Neg"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="VLResultDate" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="VLResult_CopiesPerML" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
			<xs:element name="TreatmentProphylaxis" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="None"/>
						<xs:enumeration value="Treatment"/>
						<xs:enumeration value="Prophylaxis"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<!-- Drug name: free text -->
			<xs:element name="DrugName" type="xs:string" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InfantHIVProphylaxisType">
		<xs:sequence>
			<xs:element name="DateOfInitiation" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="AgeAtInitiation_wks" type="xs:int" minOccurs="0" maxOccurs="1"/>
			<xs:element name="TypeOfProphylaxis" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="NVP"/>
						<xs:enumeration value="AZT"/>
						<xs:enumeration value="NVP+AZT"/>
						<xs:enumeration value="AZT+3TC+NVP"/>
						<xs:enumeration value="None"/>
						<xs:enumeration value="Other"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OtherSpecify" type="xs:string" minOccurs="0" maxOccurs="1"/>
			<xs:element name="DateOfCompletion" type="xs:date" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InfantSyphilisProphylaxisType">
		<xs:sequence>
			<xs:element name="DateOfInitiation" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="AgeAtInitiation_wks" type="xs:int" minOccurs="0" maxOccurs="1"/>
			<xs:element name="TypeOfProphylaxis" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="BPG(1dose)"/>
						<xs:enumeration value="BPG(3doses)"/>
						<xs:enumeration value="ProcainePenicillinG"/>
						<xs:enumeration value="AqueousCrystallinePenicillinG"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InfantCTXType">
		<xs:sequence>
			<xs:element name="DateOfInitiation" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="AgeAtInitiation_Wks" type="xs:integer" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InfantHBVVaccinationType">
		<xs:sequence>
			<xs:element name="FirstDoseDate" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="FirstDoseTiming" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Within24hrs"/>
						<xs:enumeration value="After24hrs"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="SecondDoseDate" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ThirdDoseDate" type="xs:date" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="PCRAgeAtTestType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="AtBirth_LTE72Hrs"/>
			<xs:enumeration value="GT72Hrs_LT2Months"/>
			<xs:enumeration value="TwoTo12Months"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PCRRapidTestResultType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Positive"/>
			<xs:enumeration value="Negative"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="DPCRTestType">
		<xs:sequence>
			<xs:element name="DateSampleCollected" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Result" type="PCRRapidTestResultType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="DateResultReceived" type="xs:date" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ConfirmatoryPCRType">
		<xs:sequence>
			<xs:element name="DateSampleCollected" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Result" type="PCRRapidTestResultType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="InfantOutcomeStatusType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="HIVPositiveLinkedtoART"/>
			<xs:enumeration value="HIVPositiveNotLinkedToART"/>
			<xs:enumeration value="HIVNeg"/>
			<xs:enumeration value="StillBreastfeeding"/>
			<xs:enumeration value="TransferredOut"/>
			<xs:enumeration value="LostToFollowUp"/>
			<xs:enumeration value="Dead"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="DeliveryChildrenDetailsType">
		<xs:sequence>
			<xs:element name="DateOfDelivery" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ModeOfDelivery" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Vaginal"/>
						<xs:enumeration value="ElectiveCS"/>
						<xs:enumeration value="EmergencyCS"/>
						<xs:enumeration value="Other"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="BirthWeight_kg" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
			<xs:element name="BirthLength_cm" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
			<xs:element name="BirthOutcome" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Dead"/>
						<xs:enumeration value="Alive"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ChildHospitalNumber" type="xs:string" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ChildEntryPoint" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="ANC"/>
						<xs:enumeration value="LD"/>
						<xs:enumeration value="Postnatal"/>
						<xs:enumeration value="Immunization"/>
						<xs:enumeration value="OPD"/>
						<xs:enumeration value="Inpatient"/>
						<xs:enumeration value="Nutrition"/>
						<xs:enumeration value="FamilyPlanning"/>
						<xs:enumeration value="TransferIn"/>
						<xs:enumeration value="Other"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Sex" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="M"/>
						<xs:enumeration value="F"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="HIVProphylaxis" type="InfantHIVProphylaxisType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="SyphilisProphylaxis" type="InfantSyphilisProphylaxisType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="CTX" type="InfantCTXType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="HBVVaccination" type="InfantHBVVaccinationType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="DNAPCR" type="DPCRTestType" minOccurs="0" maxOccurs="3"/>
			<xs:element name="RapidTestAt18Months" type="ConfirmatoryPCRType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="OutcomeAt18Months" type="InfantOutcomeStatusType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MotherCurrentARTRegimenType">
		<xs:sequence>
			<xs:element name="RegimenCode" type="xs:string" minOccurs="0" maxOccurs="1"/>
			<xs:element name="RegimenDescription" type="xs:string" minOccurs="0" maxOccurs="1"/>
			<xs:element name="RegimenNDRCode" type="xs:string" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PairCardVisitVLType">
		<xs:sequence>
			<xs:element name="DateSampleCollected" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="DateResultReceived" type="xs:date" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ResultCopiesPerML" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MotherInfantPairVisitType">
		<xs:sequence>
			<xs:element name="VisitId" type="xs:string" minOccurs="1" maxOccurs="1"/>
			<xs:element name="VisitDate" type="xs:date" minOccurs="1" maxOccurs="1"/>
			<xs:element name="Scheduled" type="xs:boolean" minOccurs="0" maxOccurs="1"/>
			<xs:element name="GestationalAge_Weeks" type="xs:integer" minOccurs="0" maxOccurs="1"/>
			<xs:element name="MotherWeight_kg" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
