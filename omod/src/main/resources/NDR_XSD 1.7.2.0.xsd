	<xs:complexType name="LaboratoryReportType">
		<xs:sequence>
			<xs:element name="VisitID" type="StringType" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        The unique Visit
                        Identifier that this Order / Resulted Test(s)
                        combination is linked
                        to
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VisitDate" type="xs:date" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Date of Visit
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LaboratoryTestIdentifier" type="StringType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        The unique identifier
                        that represents the Order / Resulted Test(s)
                        combination
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BaselineRepeatCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:annotation>
						<xs:documentation xml:lang="en">
                            Indicates whether the
                            Laboratory Order represents a baseline or repeat
                        </xs:documentation>
					</xs:annotation>
					<xs:restriction base="CodeType">
						<xs:enumeration value="B"/>
						<xs:enumeration value="R"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ARTStatusCode" type="CodeType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Patient's ART Status at
                        time of Laboratory Test
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionDate" type="xs:date" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Date Specimen was
                        collected
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LaboratoryOrderAndResult" type="LaboratoryOrderAndResult" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Clinician" type="StringType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Captures the clinician
                        who ordered the Laboratory Test
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReportedBy" type="StringType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Captures Reported By
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CheckedBy" type="StringType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Captures Checked By
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LaboratoryOrderAndResult">
		<xs:sequence>
			<xs:element name="OrderedTestDate" type="xs:date" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Date Order was made
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LaboratoryOrderedTest" type="CodedSimpleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Code that represents
                        the Ordered Test
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LaboratoryResultedTest" type="CodedSimpleType" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Code that represents
                        the Resulted Test
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LaboratoryResult" type="AnswerType" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Captures the type of
                        result (Numeric (including Units), Coded, Text, Date)
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResultedTestDate" type="xs:date" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Date Results are made
                        available
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OtherLaboratoryInformation" type="StringType" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                        Captures additional
                        (free form) laboratory information
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<!-- ==================== NEW ==================== -->
			<!-- Specimen Information -->
			<xs:element name="LaboratoryTestTypeCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Type of Laboratory Test
                </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="HIV"/>
						<!-- Viral Load (HIV) -->
						<xs:enumeration value="HBV"/>
						<!-- Viral Load (HBV) -->
						<xs:enumeration value="CV"/>
						<!-- Viral Load (HCV) -->
						<xs:enumeration value="EID"/>
						<!-- Early Infant Diagnosis -->
						<xs:enumeration value="CD4"/>
						<!-- CD4 Count (cells/ml) -->
						<xs:enumeration value="OtherTest"/>
						<!-- Other Test -->
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="SpecimenCollectionDate" type="xs:date" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Date specimen was collected (dd/mm/yyyy)
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecimenTypeCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="WholeBlood"/>
						<xs:enumeration value="Plasma"/>
						<xs:enumeration value="DBS"/>
						<!-- Dried Blood Spot -->
						<xs:enumeration value="PBS"/>
						<!-- Peripheral Blood Smear -->
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="SampleReceivedAtLabDate" type="xs:date" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Date sample was received at the PCR/POC laboratory
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SampleLoggedRemotely" type="YNCodeType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="LabRegistrationNumber" type="StringType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Laboratory registration number assigned to the sample
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PCRPOCLabName" type="StringType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Name of the PCR/POC laboratory processing the sample
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PCRPOCLabSampleNumber" type="StringType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Sample number assigned by the PCR/POC laboratory
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<!-- Viral Load -->
			<xs:element name="ViralLoadIndicationCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="Baseline"/>
						<!-- 6 months after ART initiation -->
						<xs:enumeration value="Routine"/>
						<!-- Every 12 months -->
						<xs:enumeration value="ClinicalFailure"/>
						<xs:enumeration value="ImmunologicFailure"/>
						<xs:enumeration value="Confirmation"/>
						<!-- 3-6 months after EAC -->
						<xs:enumeration value="RecentInfection"/>
						<xs:enumeration value="Gestation3236Weeks"/>
						<!-- 32-36 weeks of gestation age -->
						<xs:enumeration value="EarlyHIVDetection"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ViralLoadResult" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Viral load result in copies/ml
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ViralLoadResultDate" type="xs:date" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Date viral load result was received
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<!-- EID (Early Infant Diagnosis) -->
			<xs:element name="EIDIndicationCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="EIDAtBirth"/>
						<xs:enumeration value="EIDAt6To8Weeks"/>
						<xs:enumeration value="EIDAt2To12Months"/>
						<xs:enumeration value="RepeatInvalidTest"/>
						<xs:enumeration value="RepeatAfterBreastfeedingCessation"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="EIDEntryPointCode" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Entry point for Early Infant Diagnosis
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EIDResultCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="Negative"/>
						<xs:enumeration value="Positive"/>
						<xs:enumeration value="Invalid"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="EIDAgeCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="LessThanOrEqual72hrs"/>
						<xs:enumeration value="GreaterThan72hrsLessThan2Months"/>
						<xs:enumeration value="GreaterThanOrEqual2MonthsTo12Months"/>
						<xs:enumeration value="GreaterThan12Months"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<!-- CD4 -->
			<xs:element name="CD4CellCount" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    CD4+ cell count result in cells/mm3
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CD4Percentage" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    CD4 percentage result (%)
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CD4LFAResultCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="LessThan200"/>
						<!-- Below reference: CD4 < 200 cells/ul -->
						<xs:enumeration value="GTEqual200"/>
						<!-- Above reference: CD4 ≥ 200 cells/ul -->
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<!-- Glucose and Lipids -->
			<xs:element name="RandomGlucose" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Random Glucose result (mmol/l)
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<!-- Hepatitis and Serology -->
			<xs:element name="HBsAGResultCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="Negative"/>
						<xs:enumeration value="Positive"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="HCVAntibodyResultCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="Negative"/>
						<xs:enumeration value="Positive"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="HBVViralLoad" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Hepatitis B Virus Viral Load result
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HCVViralLoad" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Hepatitis C Virus Viral Load result
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<!-- Syphilis / STI Serology -->
			<xs:element name="VDRLSyphilisResultCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="NonReactive"/>
						<xs:enumeration value="Reactive"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<!-- Cryptococcal and CNS Tests -->
			<xs:element name="SerologyForCrAgResultCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="Negative"/>
						<xs:enumeration value="Positive"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CSFForCrAgResultCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="Negative"/>
						<xs:enumeration value="Positive"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<!-- TB-related Tests -->
			<xs:element name="TBLFLAMResultCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="Negative"/>
						<xs:enumeration value="Positive"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="HPVResultCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="Negative"/>
						<xs:enumeration value="Positive"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CytologyVIAPapSmearResult" type="StringType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Cytology result from VIA/Pap Smear
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Urinalysis" type="StringType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Urinalysis result including glucose and protein findings
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<!-- Drug Regimen Context -->
			<xs:element name="ARTStartDate" type="xs:date" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
                    Date patient started ART (dd/mm/yyyy)
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DrugRegimenLineCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="FirstLine"/>
						<xs:enumeration value="SecondLine"/>
						<xs:enumeration value="ThirdLine"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ARVProphylaxisReceivedCode" minOccurs="0" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="AZT_NVP"/>
						<xs:enumeration value="NVP"/>
						<xs:enumeration value="AZT_3TC_NVP_RAL"/>
						<xs:enumeration value="Others"/>
						<xs:enumeration value="No"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ContactType">
		<xs:sequence>
			<xs:element name="ContactRelationshipType" type="CodeType" minOccurs="1" maxOccurs="1">
