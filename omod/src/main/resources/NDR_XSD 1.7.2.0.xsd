            <xs:element name="MaritalStatus" type="StringType" minOccurs="0" maxOccurs="1" />
            <xs:element name="NumberOfOwnChildrenUnder5" type="xs:int" minOccurs="0" maxOccurs="1" />
            <xs:element name="Weight" type="xs:decimal" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>Weight in kg</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="TypeOfSession" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Individual" />
                        <xs:enumeration value="Couple" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="SexPartners" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Male" />
                        <xs:enumeration value="Female" />
                        <xs:enumeration value="Both" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="PregnancyStatus" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="P" />   <!-- Pregnant -->
                        <xs:enumeration value="BF" />  <!-- Breastfeeding -->
                        <xs:enumeration value="NP" />  <!-- Not Pregnant -->
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>

            <!-- Section A: Sex Partner Risk (Last 3 Months) -->
            <xs:element name="PartnerIsHivPositive" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="PartnerInjectsDrugs" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="PartnerHasSexWithMen" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="PartnerIsTransgender" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="PartnerHasMultiplePartnersWithoutCondoms" type="xs:boolean" minOccurs="0" maxOccurs="1" />

            <!-- Section B: Personal HIV Risk (Last 3 Months) -->
            <xs:element name="UnprotectedVaginalSexWithCasualPartner" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="UnprotectedAnalSex" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="SharedNeedlesOrInjectingMaterials" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="MoreThanOneSexPartner" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="PaidOrBeenPaidForSex" type="xs:boolean" minOccurs="0" maxOccurs="1" />

            <!-- Section C: Drug Use History (Last 3 Months) -->
            <xs:element name="UsesCocaine" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="UsesHeroin" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="UsesMarijuana" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="UsesAmphetamine" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="UsesCodeineSyrup" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="UsesOtherDrugs" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="OtherDrugsSpecify" type="StringType" minOccurs="0" maxOccurs="1" />
            <xs:element name="RouteInject" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="RouteSniff" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="RouteSnort" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="RouteSmoke" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="UsesDrugsForSexualEnhancement" type="xs:boolean" minOccurs="0" maxOccurs="1" />

            <!-- Section D: Assessment for PEP Indication -->
            <xs:element name="HadSexWithoutCondomUnkHivStatLast72Hours" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>In the past 72 hours, had unprotected sex with a person whose HIV status is positive or unknown</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="SharedInjectionEquipmentUnkHivStatLast72Hours" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>In the past 72 hours, shared injection equipment with a person whose HIV status is positive or unknown</xs:documentation>
                </xs:annotation>
            </xs:element>

            <!-- Section E: Assessment for Acute HIV Infection -->
            <xs:element name="HadColdFluSymptomsLast2Weeks" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Fever, sore throat, abnormal sweats, swollen lymph nodes, mouth sores, headache, or rash in the past two weeks</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="HadUnprotectedSexOrSharedMaterialsLast28Days" type="xs:boolean" minOccurs="0" maxOccurs="1" />

            <!-- Section F: STI Screening -->
            <xs:element name="FemaleVaginalDischargeOrBurning" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="FemaleLowerAbdominalPain" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="MaleUrethralDischargeOrBurning" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="MaleScrotumSwellingAndPain" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="GenitalSores" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="SwollenInguinalLymphNodes" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="AnalPainOnStooling" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="AnalItching" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="AnalDischarge" type="xs:boolean" minOccurs="0" maxOccurs="1" />

            <!-- HIV Testing -->
            <xs:element name="LastHivTestTimeframe" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="LessThan1Month" />
                        <xs:enumeration value="1To3Months" />
                        <xs:enumeration value="4To6Months" />
                        <xs:enumeration value="MoreThan6Months" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="RecommendedForHivRetest" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="TestedInOtherClinicalSettings" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="HivTestResult" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Negative" />
                        <xs:enumeration value="Positive" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="ReportsOngoingHivRiskBehaviors" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="ReportsSpecificHivExposureLast3Months" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="AcuteHivInfectionRetestRecommended" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>If client tests HIV negative with signs/symptoms of acute HIV infection, recommend retest after 1 month</xs:documentation>
                </xs:annotation>
            </xs:element>

            <!-- PrEP Eligibility Scoring -->
            <xs:element name="HivNegative" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="HivRiskScoreAtLeastOne" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="NoSignsOfAcuteHivInfection" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="NoIndicationForPep" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="HasNoProteinuria" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Required for clients above 30 years of age</xs:documentation>
                </xs:annotation>
            </xs:element>

            <!-- Consideration for Injectable PrEP -->
            <xs:element name="NoHistoryOfLiverAbnormalities" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="NoHistoryOfDrugDrugInteractionsForInjectable" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="NoHistoryOfDrugHypersensitivity" type="xs:boolean" minOccurs="0" maxOccurs="1" />

            <!-- PrEP Initiation Decision -->
            <xs:element name="PrepOffered" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="WillingToCommencePrEP" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="ReceivedPrepForFirstTimeThisYear" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="ClientReferredToOtherServices" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="ReferralServiceSpecify" type="StringType" minOccurs="0" maxOccurs="1" />

            <!-- Reasons for Declining PrEP -->
            <xs:element name="DeclineNoNeedForPrep" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="DeclineDoesNotWishDailyMedication" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="DeclineConcernAboutSideEffects" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="DeclineConcernAboutStigmatization" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="DeclineConcernAboutClinicFollowupTime" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="DeclineConcernAboutSafetyOfMedication" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="DeclineConcernAboutEffectiveness" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="DeclineOtherReasonSpecify" type="StringType" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
    </xs:complexType>

    <!--
    ================================================================
      2.  CARD ENROLLMENT AND INITIATION
    ================================================================
    -->
    <xs:complexType name="PrepPepCardEnrollmentType">
        <xs:sequence>

            <!-- Enrollment -->
            <xs:element name="HospitalNumber" type="StringType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Opaque facility system reference. Not used as a name identifier.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="EnrollmentType" minOccurs="1" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="PrEP" />
                        <xs:enumeration value="PEP" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="UniqueId" type="StringType" minOccurs="1" maxOccurs="1" />
            <xs:element name="DateEnrolled" type="xs:date" minOccurs="1" maxOccurs="1" />
            <xs:element name="PartnerAncOrUniqueArtNumber" type="StringType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Partner ANC number or Unique ART number for serodiscordant couples</xs:documentation>
                </xs:annotation>
            </xs:element>

            <!-- Client Profile (non-PII) -->
            <xs:element name="Sex" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="M" />
                        <xs:enumeration value="F" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="Age" type="xs:int" minOccurs="0" maxOccurs="1" />
            <xs:element name="MaritalStatus" minOccurs="0" maxOccurs="1">
            <xs:annotation>
                    <xs:documentation>1=Single, 2=Married, 3=Divorced, 4=Separated 5=Cohabiting 6=Widowed</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                    </xs:restriction>
                </xs:simpleType>
             </xs:element>
            <xs:element name="Occupation" type="StringType" minOccurs="0" maxOccurs="1" />
            <xs:element name="EducationLevel" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>1=None,2=Primary, 3=Secondary, 4=Tertiary</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>

            <!-- HIV Testing at Enrollment -->
            <xs:element name="HivTestingPoint" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>1=Facility,2=Community, 3=Others</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
  
            <xs:element name="DateOfLastHivTest" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="HivTestResult" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Negative" />
                        <xs:enumeration value="Positive" />
                        <xs:enumeration value="SuspectedAcuteHIVInfection" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>

            <!-- Referral -->
            <xs:element name="DateReferred" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="PopulationType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        1=SerodiscordantCouples, 2=SexWorkers, 3=PartnersOfSexWorkers,
                        4=InjectingDrugUsers, 5=AnalSexIndividuals,
                        6=ExposedAdolescentsAndYoungPeople, 7=Transgender,
                        8=AtRiskPregnantAndBreastfeedingWomen, 9=OtherPopulation
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                        <xs:enumeration value="7" />
                        <xs:enumeration value="8" />
                        <xs:enumeration value="9" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="OtherPopulationSpecify" type="StringType" minOccurs="0" maxOccurs="1" />
           
            <!-- PrEP / PEP Initiation -->
            <xs:element name="DateInitialAdherenceCounseling" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="DateStarted" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="PrepTypeAtStart" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        1 = Oral, 2 = Injectable, 3 = Ring, 4 = Others
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="PrepRegimen" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        1 = TDF/FTC, 2 = TDF/3TC, 3 = Cabotegravir, 4= Lenacapavir , 5 = Others
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="Weight" type="xs:decimal" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>Weight in kg</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="Height" type="xs:decimal" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>Height in metres</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="BMI" type="xs:decimal" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>Body Mass Index (kg/m2)</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="IsPregnant" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="IsBreastfeeding" type="xs:boolean" minOccurs="0" maxOccurs="1" />
            <xs:element name="HistoryOfDrugAllergies" type="StringType" minOccurs="0" maxOccurs="1" />
            <xs:element name="HistoryOfDrugDrugInteractions" minOccurs="0" maxOccurs="1">
               <xs:annotation>
                    <xs:documentation>
                        1 = Rifampicin, 2 = Rifapentine, 3 = Carpamazepine, 4 = Oxcarbazepine, 5 = Phenobarbital, 6 = Phenytoin, 7 = Methadone, 8 = Exogenous Hormones
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                        <xs:enumeration value="7" />
                        <xs:enumeration value="8" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="UrinalysisResult" type="StringType" minOccurs="0" maxOccurs="1" />
            <xs:element name="LiverFunctionTestResult" type="StringType" minOccurs="0" maxOccurs="1" />
            <xs:element name="ReferredAtInitiation" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Yes" />
                        <xs:enumeration value="No" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="DateReferredAtInitiation" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="ServiceReferredFor" minOccurs="0" maxOccurs="1">
             <xs:annotation>
                    <xs:documentation>
                        1 = Condom Provision, 2= STI Management, 3 = Family Planning/RH, 4 = ART, 5 = Mental Health Screening, 6 = Other
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>

            <!-- PEP Completion (for PEP enrollments) -->
            <xs:element name="PepCompletion" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Yes" />
                        <xs:enumeration value="No" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>

          <!-- Early HIV Detection table (card front page PEP section) -->
        <xs:element name="PepFollowUpEntry" type="PepFollowUpEntryType"
                    minOccurs="0" maxOccurs="unbounded" />

        </xs:sequence>
    </xs:complexType>

    <!-- Child type for the PEP follow-up visit table on the card front page -->
    <xs:complexType name="PepFollowUpEntryType">
        <xs:sequence>
            <xs:element name="FollowUpVisitDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Date of the PEP follow-up visit for early HIV detection</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="HivResult" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Pos" />
                        <xs:enumeration value="Neg" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="EarlyHivDetectionViralLoadResult" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="TargetDetected" />
                        <xs:enumeration value="TargetNotDetected" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!--
    ================================================================
      3.  PrEP FOLLOW-UP VISIT
    ================================================================
    -->
    <xs:complexType name="PrepFollowUpVisitType">
        <xs:sequence>

            <xs:element name="VisitID" type="StringType" minOccurs="1" maxOccurs="1">
                <xs:annotation><xs:documentation>Unique identifier for this follow-up visit</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="VisitDate" type="xs:date" minOccurs="1" maxOccurs="1" />
            <xs:element name="VisitType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        1=Initiation, 2=SecondInitiation, 3=Refill/Re-Injection,
                        4=MethodSwitch, 5=Restart, 6=TransferIn, 7=NoPrepProvided,
                        8=Discontinuation, 9=DiscontinuationFollowUp
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                        <xs:enumeration value="7" />
                        <xs:enumeration value="8" />
                        <xs:enumeration value="9" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="DurationOnPrepMonths" type="xs:int" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>Duration on PrEP in months at this visit</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="PregnancyStatus" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="P" />
                        <xs:enumeration value="BF" />
                        <xs:enumeration value="NP" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="Weight" type="xs:decimal" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>Weight in kg</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="BloodPressure" type="StringType" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>Blood pressure in mmHg (e.g. 120/80)</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="HtsResult" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        HIV Testing Service result code at this visit
                        1=HIV Positive, 2=HIV Negative, 3=Suspected Acute HIV, 4=Not Done
                    </xs:documentation>
                </xs:annotation>
                 <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="NotedSideEffects" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Side effects noted at this visit
                        0=No side effects, 1=Nausea/vomiting, 2=Headache, 3=Insomnia/bad dreams, 4=Fatigue/weakness, 5=Abdominal pain, 
                        6=Diarrhea, 7=Fever, 8=Rash, 9=Anemia, 10=Stevens-Johnson Syndrome, 11=Hyperglycemia, 12=Other
                    </xs:documentation>
                </xs:annotation>
                 <xs:simpleType>
                    <xs:restriction base="CodeType">
                       <xs:enumeration value="0" />
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                        <xs:enumeration value="7" />
                        <xs:enumeration value="8" />
                        <xs:enumeration value="9" />
                        <xs:enumeration value="10" />
                        <xs:enumeration value="11" />
                        <xs:enumeration value="12" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="SyndromicSTIScreening" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Syndromic STI screening results at this visit
                        0=No syndromic STI symptoms/signs, 1=Urethral discharge, 2=Genital ulcer, 3=Vaginal discharge, 4=Lower abdominal pain, 
                        5=Scrotal swelling, 6=Anal warts, 7=Genital warts, 8=Inguinal bubo, 9=Others
                    </xs:documentation>
                </xs:annotation>
                 <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                        <xs:enumeration value="7" />
                        <xs:enumeration value="8" />
                        <xs:enumeration value="9" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <!-- <xs:element name="PresenceOfSTI" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Yes" />
                        <xs:enumeration value="No" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element> -->
            <xs:element name="RiskReductionServices" minOccurs="0" maxOccurs="1">
             <xs:annotation>
                    <xs:documentation>
                        Risk reduction services received at this visit
                        1=Risk Reduction strategies discussed | 2 = Plan 1 plus correct condom use demonstrated | Plan 1 and 2 plus lubricant provided
                    </xs:documentation>
                </xs:annotation>
                 <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="Adherence" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Adherence level at this visit (based on self-report or provider assessment)
                        G = Good (≥95%  - less than or equal 1 doses) | F = Fair (85–94% - 2-5 doses) | P = Poor (greater than or equal 85% - greater than or equal 6 doses)
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="G" />
                        <xs:enumeration value="F" />
                        <xs:enumeration value="P" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="ReasonForPoorFairAdherence" minOccurs="0" maxOccurs="1">
             <xs:annotation>
                    <xs:documentation>
                        Reason for poor/fair adherence (based on self-report or provider assessment)
                        1 = Forgot | 2 = Fell asleep/slept through dose| 3=change in routine/away from home|4=Busy/working/at school |5= Patient moved | 6 = Ran out of medications | 7 = Drug stock-out | 8=Not able to pay | 9=Partner influence|10= Other
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                        <xs:enumeration value="7" />
                        <xs:enumeration value="8" />
                        <xs:enumeration value="9" />
                        <xs:enumeration value="10" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="PrepType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        PrEP type at this visit
                        1 = Oral, 2 = Injectable, 3 = Ring, 4 = Others
                    </xs:documentation>
                </xs:annotation>
                 <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="PrepRegimen" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        PrEP regimen at this visit
                        1 = TDF/FTC, 2 = TDF/3TC, 3 = Cabotegravir, 4= Lenacapavir
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>

            <xs:element name="MonthsOfRefill" type="xs:int" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>Number of months of PrEP provided at this visit</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="OtherDrugsPrescribed" type="StringType" minOccurs="0" maxOccurs="1" />

            <!-- Lab Tests -->
            <xs:element name="DateOfUrinalysis" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="UrinalysisResult" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>                
                        Urinalysis result from register field
                        1= No proteinuria, 2= Proteinuria Present - One +, 3= Proteinuria Present - Two ++, 4= Proteinuria Present - Three +++
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>           
            <xs:element name="DateOfHepatitisTest" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="HepatitisTestResult" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Hepatitis test result from register field
                        1= Hepatitis B Postivie, 2 = Hepatitis B Negative, 3= Hepatitis C Positive, 4= Hepatitis C Negative
                        5 = HIV/HBV Coinfected, 6 = HIV/HCV Coinfected
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />    
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>

            <xs:element name="DateOfSyphilisTest" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="SyphilisTestResult" minOccurs="0" maxOccurs="1">
             <xs:annotation>
                    <xs:documentation>
                        Syphilis test result from register field
                        1= Negative, 2 = Positive, 3= Not Done, 4 = Others
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="DateOfLiverFunctionTest" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="LiverFunctionTestResult" minOccurs="0" maxOccurs="1">
             <xs:annotation>
                    <xs:documentation>
                        Liver function test result from register field
                        1=Alanine Aminoransferase (ALT) Normal | 2=Alanine Aminoransferase (ALT) Deranged | 3=Alkaline Phosphatase (ALP) Normal |
                         4= Alkaline Phosphatase (ALP) Deranged | 5 = Aspartate Aminoransferase (AST) Normal | 
                         6=Aspartate Aminoransferase (AST) Deranged | 7=Gamma Glutamyl transferase (GGT) Normal | 
                         8=Gamma Glutamyl transferase (GGT) Deranged | 9=Bilirubin Normal | 10=Bilirubin Deranged | 
                         11=Albumin Normal | 12=Albumin Deranged | 13=Total protein Normal | 14=Total protein Deranged 
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                        <xs:enumeration value="7" />
                        <xs:enumeration value="8" />
                        <xs:enumeration value="9" />
                        <xs:enumeration value="10" />
                        <xs:enumeration value="11" />
                        <xs:enumeration value="12" />
                        <xs:enumeration value="13" />
                        <xs:enumeration value="14" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="DateOfOtherTests" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="OtherTestsResult" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Other test result from register field; 
                        1=HB/PCV|2=WBC+Diff | 3=ALT|4=AST|5=Creatinine|6=Lipid Profile | 7=HBsAg|
                        8=Urinalysis |9=Sputum AFB |10=Chest Xray |11=Others
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                        <xs:enumeration value="7" />
                        <xs:enumeration value="8" />
                        <xs:enumeration value="9" />
                        <xs:enumeration value="10" />
                        <xs:enumeration value="11" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>

            <!-- Early HIV Detection (from register) -->
            <xs:element name="SuspectedAcuteInfection" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Yes" />
                        <xs:enumeration value="No" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="EarlyHivDetectionViralLoadResult" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="TargetDetected" />
                        <xs:enumeration value="TargetNotDetected" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>

            <xs:element name="NextAppointmentDate" type="xs:date" minOccurs="0" maxOccurs="1" />

        </xs:sequence>
    </xs:complexType>

    <!--
    ================================================================
      4.  PEP FOLLOW-UP VISIT
    ================================================================
    -->
    <xs:complexType name="PepFollowUpVisitType">
        <xs:sequence>

            <xs:element name="VisitID" type="StringType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Unique identifier for this PEP follow-up visit</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="VisitDate" type="xs:date" minOccurs="1" maxOccurs="1" />
            <xs:element name="ModeOfExposure" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>
                Mode of HIV exposure; use code per tool specification
                1 = Occupational, 2 = Non-Occupational, 3 = Suspected Acute HIV Infection 
                </xs:documentation></xs:annotation>
                 <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="DurationBeforePepProvided" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                    Time elapsed between exposure and PEP provision; use code per tool specification
                    1=Less than 24 Hours | 2=Less than 48 Hours | 3=Less than 72 Hours | 4=More than 72 Hours
                    </xs:documentation>
                </xs:annotation>
                 <xs:simpleType>
                        <xs:restriction base="CodeType">
                            <xs:enumeration value="1" />
                            <xs:enumeration value="2" />
                            <xs:enumeration value="3" />
                            <xs:enumeration value="4" />
                        </xs:restriction>
                    </xs:simpleType>
            </xs:element>
            <xs:element name="BloodPressure" type="StringType" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>Blood pressure in mmHg</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="HivStatusAtExposure" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                    HIV status of source person at time of exposure; use code per tool specification
                    1=Positive| 2=Negative | 3=Suspected Acute HIV Infection
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="NotedSideEffects" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Side effects noted at this PEP follow-up visit
                        0=No side effects, 1=Nausea/vomiting, 2=Headache, 3=Insomnia/bad dreams, 4=Fatigue/weakness, 5=Abdominal pain, 
                        6=Diarrhea, 7=Fever, 8=Rash, 9=Anemia, 10=Stevens-Johnson Syndrome, 11=Hyperglycemia, 12=Other
                    </xs:documentation>
                </xs:annotation>
                 <xs:simpleType>
                    <xs:restriction base="CodeType">
                       <xs:enumeration value="0" />
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />   
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                        <xs:enumeration value="7" />
                        <xs:enumeration value="8" />
                        <xs:enumeration value="9" />
                        <xs:enumeration value="10" />
                        <xs:enumeration value="11" />
                        <xs:enumeration value="12" />
                    </xs:restriction>
                </xs:simpleType>    
            </xs:element>
            <xs:element name="SyndromicSTIScreening" minOccurs="0" maxOccurs="1">
             <xs:annotation>
                    <xs:documentation>
                        Syndromic STI screening results at this PEP follow-up visit
                        0=No syndromic STI symptoms/signs, 1=Urethral discharge, 2=Genital ulcer, 3=Vaginal discharge, 4=Lower abdominal pain, 
                        5=Scrotal swelling, 6=Anal warts, 7=Genital warts, 8=Inguinal bubo, 9=Others
                    </xs:documentation>
                </xs:annotation>
             <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                        <xs:enumeration value="4" />
                        <xs:enumeration value="5" />
                        <xs:enumeration value="6" />
                        <xs:enumeration value="7" />
                        <xs:enumeration value="8" />
                        <xs:enumeration value="9" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="RiskReductionServices"  minOccurs="0" maxOccurs="1">
             <xs:annotation>
                    <xs:documentation>
                        Risk reduction services received at this PEP follow-up visit
                       1=Risk Reduction strategies discussed | 2 = Plan 1 plus correct condom use demonstrated | Plan 1 and 2 plus lubricant provided
                    </xs:documentation>
                </xs:annotation>
             <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                        <xs:enumeration value="3" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="Adherence" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                       Adherence to PEP regimen at this follow-up visit
                          G = Good (≥95%  - less than or equal 1 doses) | F = Fair (85–94% - 2-5 doses) | P = Poor (greater than or equal 85% - greater than or equal 6 doses)
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="G" />
                        <xs:enumeration value="F" />
                        <xs:enumeration value="P" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="PepRegimen" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        PEP regimen at this follow-up visit
                        1=TDF+3TC+DTG | 2=Other
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="DatePepGivenStart" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="DatePepGivenStop" type="xs:date" minOccurs="0" maxOccurs="1" />

            <!-- Follow-up HIV Test Results -->
            <xs:element name="FollowUpHivTestResult1st6Weeks" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Pos" />
                        <xs:enumeration value="Neg" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="FollowUpHivTestResult2nd3Months" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Pos" />
                        <xs:enumeration value="Neg" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="FollowUpHivTestResult3rd6Months" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Pos" />
                        <xs:enumeration value="Neg" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>

            <xs:element name="ReferIfPositive" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="Yes" />
                        <xs:enumeration value="No" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="NextAppointmentDate" type="xs:date" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
    </xs:complexType>

    <!--
    ================================================================
      5.  DISCONTINUATION AND INTERRUPTIONS
    ================================================================
    -->
    <xs:complexType name="PrepDiscontinuationType">
        <xs:sequence>

            <!-- PrEP Interruptions (repeatable — card has up to 3 rows) -->
            <xs:element name="Interruption" type="PrepInterruptionType"
                        minOccurs="0" maxOccurs="unbounded" />

            <!-- Referral Out -->
            <xs:element name="DateClientReferredOut" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="FacilityReferredTo" type="StringType" minOccurs="0" maxOccurs="1" />

            <!-- Mortality -->
            <xs:element name="DateClientDied" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="SourceOfDeathInformation" type="StringType" minOccurs="0" maxOccurs="1" />
            <xs:element name="CauseOfDeath" type="StringType" minOccurs="0" maxOccurs="1" />

            <!-- From Register -->
			<xs:element name="DiscontinuedPrepPepReason" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Discontinuation reason code per tool specification
						1. Dead 2. Stopped. 3. Seroconverted 4. Transfer out
						5. Loss to follow up. 6.Adverse drug reaction 7. No longer at substantial risk
					</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="1" />
						<!-- Dead -->
						<xs:enumeration value="2" />
						<!-- Stopped -->
						<xs:enumeration value="3" />
						<!-- Seroconverted -->
						<xs:enumeration value="4" />
						<!-- Transfer out -->
						<xs:enumeration value="5" />
						<!-- Loss to follow up -->
						<xs:enumeration value="6" />
						<!-- Adverse drug reaction -->
						<xs:enumeration value="7" />
						<!-- No longer at substantial risk -->
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
            <xs:element name="DiscontinuedPrepPepDate" type="xs:date" minOccurs="0" maxOccurs="1" />
            <xs:element name="ArtLinkDate" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>Date client was linked to ART following positive HIV test</xs:documentation></xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Interruption row (Stopped or Defaulted, with optional restart) -->
    <xs:complexType name="PrepInterruptionType">
        <xs:sequence>
            <xs:element name="InterruptionReason" minOccurs="1" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="CodeType">
                        <xs:enumeration value="S" />  <!-- Stopped -->
                        <xs:enumeration value="D" />  <!-- Defaulted -->
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="InterruptionDate" type="xs:date" minOccurs="1" maxOccurs="1" />
            <xs:element name="WhyCode" type="CodeType" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>Reason code per tool specification</xs:documentation></xs:annotation>
            </xs:element>
            <xs:element name="DateOfRestart" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation><xs:documentation>Date client was placed back on medication, if applicable</xs:documentation></xs:annotation>
            </xs:element>
