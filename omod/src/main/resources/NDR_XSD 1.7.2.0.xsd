				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="CodeType">
					<xs:enumeration value="RemainOnCurrentRegimen"/>          <!-- Remain on current regimen -->
					<xs:enumeration value="RegimenSwitchedBySwitchCommittee"/> <!-- Regimen switched by the switch committee -->
					<xs:enumeration value="ReferToDoctorForFurtherManagement"/> <!-- Refer to doctor for further management -->
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element name="VLPlanOutcomeDate" type="xs:date" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
					Date the clinical plan was enacted (DD/MM/YYYY)
					</xs:documentation>
				</xs:annotation>
			</xs:element>

				<!-- EAC Monitoring -->
			<xs:element name="EACMonitoringOutcomeCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="en">
