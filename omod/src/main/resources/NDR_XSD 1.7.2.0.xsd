						<xs:enumeration value="R"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<!-- Row 49 right: Recency test (positive clients only) -->
			<xs:element name="RecencyTestingResult" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>R=Recent, L=Long Term — for positive clients only</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="CodeType">
						<xs:enumeration value="R"/>
						<xs:enumeration value="L"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="IndexContactTesting" type="IndexContactTestingType" minOccurs="0" maxOccurs="1"/>
			<!-- Rows 50-57: Post-Test Counseling -->
			<xs:element name="PostTestCounselling" type="PostTestCounsellingType" minOccurs="0" maxOccurs="1"/>
